{
  "info": {
    "name": "Food Ordering EAI Integration (Kelompok 5)",
    "description": "Postman Collection pengujian integrasi EAI Order Service (:3001) dan Kitchen Service (:3002)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Order Service - Create Order (Auto Dispatch to Kitchen)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Budi\",\n  \"items\": [\n    { \"item_name\": \"Nasi Goreng Spesial\", \"quantity\": 2, \"price\": 25000 },\n    { \"item_name\": \"Es Teh Manis\", \"quantity\": 2, \"price\": 5000 }\n  ]\n}"
        },
        "url": {
          "raw": "http://localhost:3001/api/orders",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "orders"]
        }
      }
    },
    {
      "name": "2. Kitchen Service - List Tickets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3002/api/kitchen/tickets",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3002",
          "path": ["api", "kitchen", "tickets"]
        }
      }
    },
    {
      "name": "3. Kitchen Service - Update Status to COOKING (Auto Callback)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"COOKING\"\n}"
        },
        "url": {
          "raw": "http://localhost:3002/api/kitchen/tickets/1/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3002",
          "path": ["api", "kitchen", "tickets", "1", "status"]
        }
      }
    },
    {
      "name": "4. Kitchen Service - Update Status to READY_FOR_PICKUP (Auto Callback)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"READY_FOR_PICKUP\"\n}"
        },
        "url": {
          "raw": "http://localhost:3002/api/kitchen/tickets/1/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3002",
          "path": ["api", "kitchen", "tickets", "1", "status"]
        }
      }
    },
    {
      "name": "5. Order Service - Verify Final Order Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3001/api/orders/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "orders", "1"]
        }
      }
    }
  ]
}
